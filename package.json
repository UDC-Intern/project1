{
  "name": "udakids",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @udakids/engine build && concurrently -k -n engine,api,web -c blue,yellow,green \"pnpm --filter @udakids/engine dev\" \"pnpm --filter @udakids/api dev\" \"pnpm --filter @udakids/web dev\"",
    "build": "pnpm --filter @udakids/engine build && pnpm --filter @udakids/api build && pnpm --filter @udakids/web build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "validate:content": "tsx --conditions=source scripts/validate-content.ts",
    "db:generate": "pnpm --filter @udakids/api db:generate",
    "db:migrate": "pnpm --filter @udakids/api db:migrate",
    "db:seed": "pnpm --filter @udakids/api db:seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "dev:local": "node scripts/setup-local.mjs && pnpm dev",
    "db:demo": "node scripts/seed-demo.mjs",
    "db:backup": "pnpm --filter @udakids/api db:backup",
    "db:restore": "pnpm --filter @udakids/api db:restore",
    "deploy:db": "pnpm --filter @udakids/api migrate:prod && pnpm --filter @udakids/api seed:prod",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@udakids/engine": "workspace:*",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
