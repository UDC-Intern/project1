{
  "name": "udakids",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @udakids/engine build && concurrently -k -n engine,web -c blue,green \"pnpm --filter @udakids/engine dev\" \"pnpm --filter @udakids/web dev\"",
    "build": "pnpm --filter @udakids/engine build && pnpm --filter @udakids/web build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "validate:content": "tsx --conditions=source scripts/validate-content.ts",
    "db:generate": "node -e \"console.log('Database baru dibuat di M6.')\"",
    "db:migrate": "node -e \"console.log('Database baru dibuat di M6.')\"",
    "db:seed": "node -e \"console.log('Database baru dibuat di M6.')\"",
    "db:setup": "node -e \"console.log('Database baru dibuat di M6.')\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@udakids/engine": "workspace:*",
    "@types/node": "^22.10.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
