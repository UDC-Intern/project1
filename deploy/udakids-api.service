# /etc/systemd/system/udakids-api.service
[Unit]
Description=UdaKids API (NestJS)
After=network.target postgresql.service

[Service]
Type=simple
User=udakids
WorkingDirectory=/srv/udakids/apps/api
Environment=NODE_ENV=production
# /srv/udakids/.env dimuat otomatis oleh aplikasi (DATABASE_URL, JWT_SECRET, ...)
# Terapkan migrasi baru (idempoten) setiap kali service dijalankan, lalu jalankan API
ExecStartPre=/usr/bin/node dist/cli/migrate.js
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
# Berhenti dengan SIGTERM; API memutus koneksi panjang sendiri, jadi 20 detik cukup sebelum SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=20
# Pengerasan ringan: proses tidak boleh menaikkan hak akses dan memakai /tmp pribadi.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
