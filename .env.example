# Salin ke .env (PowerShell: Copy-Item .env.example .env). .env tidak masuk git.
# Hanya variabel berawalan VITE_ yang sampai ke browser. Rahasia jangan diberi awalan VITE_.

# Web
VITE_API_URL=
VITE_MOCK_MODULES=*

# API (mulai M6)
API_PORT=7177
WEB_ORIGIN=http://localhost:6006
DATABASE_URL=
DATABASE_URL_TEST=
JWT_SECRET=
ADMIN_EMAIL=admin@udakids.local
ADMIN_PASSWORD=
ADMIN_WHATSAPP=

# Layanan (mulai M10)
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_TTS_API_KEY=
TTS_VOICE=id-ID-Chirp3-HD-Leda
TTS_DAILY_LIMIT=300
