DATABASE_DRIVER=postgres
# Salin ke .env (PowerShell: Copy-Item .env.example .env). .env tidak masuk git.
# Hanya variabel berawalan VITE_ yang sampai ke browser. Rahasia jangan diberi awalan VITE_.

# Web
VITE_API_URL=
VITE_MOCK_MODULES=

# API
API_PORT=7177
WEB_ORIGIN=http://localhost:6006
# PostgreSQL. Lokal: postgres://udakids:udakids@localhost:5432/udakids (buat role dan database dulu).
DATABASE_URL=
# Database khusus test e2e API (dikosongkan dan dimigrasi ulang setiap test).
DATABASE_URL_TEST=
# Ukuran kolam sambungan `pg` (bawaan 20) dan batas tunggu sambungan baru.
DB_POOL_MAX=20
# WAJIB (dev dan produksi), minimal 32 karakter: openssl rand -base64 48
# Jangan diganti setelah dipakai: kunci API yang disimpan admin dienkripsi dengan turunan JWT_SECRET.
JWT_SECRET=
# Admin pertama yang dibuat `pnpm db:seed` bila belum ada admin (ADMIN_PASSWORD wajib di produksi).
ADMIN_EMAIL=admin@udakids.local
ADMIN_PASSWORD=
ADMIN_WHATSAPP=
# Folder konten untuk seed (bawaan: ./content di akar repo).
CONTENT_DIR=

# Email (Gmail SMTP dengan App Password 16 huruf, bukan password Gmail biasa)
# Kosong = pesan tetap menunggu di email_outbox; isi pesan atau kode tidak dicetak ke log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UdaKids <no-reply@localhost>"
# Salinan setiap transaksi untuk pengelola (pisahkan dengan koma).
MAIL_DIRECTOR=
# Alamat web publik untuk tautan dan logo di email (produksi: https://domain-anda).
APP_PUBLIC_URL=http://localhost:6006
# "on" = pendaftar baru wajib memasukkan kode 6 angka dari email. "off" = langsung masuk (kontrak web saat ini).
EMAIL_VERIFICATION=off

# Google Identity Services (buat dari Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=

# Layanan eksternal (opsional)
# Ilustrasi AI: Images API OpenAI. Kosong = menu Ilustrasi AI tidak membuat gambar (permintaan tetap tercatat).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Batas gambar AI baru per hari (melindungi biaya).
AI_DAILY_LIMIT=30
# Suara Momo: Google Cloud Text-to-Speech (Chirp 3 HD). Kosong = tanpa klip suara, web memakai suara peramban.
GOOGLE_TTS_API_KEY=
TTS_VOICE=id-ID-Chirp3-HD-Leda
# Batas pembuatan klip suara BARU per hari (melindungi biaya). Klip yang sudah ada tidak dihitung.
TTS_DAILY_LIMIT=300
